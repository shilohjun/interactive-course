[Unit]
Description=Interactive Course static player (/course)
After=network.target

[Service]
Type=simple
WorkingDirectory=/opt/interactive-course/current
ExecStart=/usr/bin/node /opt/interactive-course/current/server.mjs
Environment=HOST=127.0.0.1
Environment=PORT=5174
Environment=DIST_ROOT=/opt/interactive-course/current
Restart=on-failure
RestartSec=2

# The service only reads a build artifact and listens on loopback.
DynamicUser=yes
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/opt/interactive-course/current
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
